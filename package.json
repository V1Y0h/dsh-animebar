{
  "name": "dsh-animebar",
  "version": "0.7.0",
  "type": "module",
  "description": "Anime airing board and capture triage for DeepSeek Harness — today's lineup from Bangumi, plus local capture records from IINA.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "captures.js",
    "triage.js",
    "tags.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "anime",
    "bangumi",
    "anime-tracker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V1Y0h/dsh-animebar.git"
  },
  "homepage": "https://github.com/V1Y0h/dsh-animebar#readme"
}
